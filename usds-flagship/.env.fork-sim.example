# Env for the Tenderly fork simulator (src/fork-sim.ts, `npm run fork-sim`).
# Copy to .env (or export in the shell) and fill in TENDERLY_RPC_URL.

# Fork source — pick ONE of the two modes:
#
# (a) reset-and-reuse (recommended): leave TENDERLY_RPC_URL unset (or set
#     SIM_FRESH_FORK=true) and provide Tenderly API credentials below. The project
#     keeps exactly ONE simulator fork (slug SIM_FORK_SLUG, default 'bands-sim');
#     each run deletes it and recreates it from mainnet at the LATEST block, then
#     prints its dashboard URL.
#     Access key: dashboard -> Account Settings -> Access Keys. The two slugs are
#     in your dashboard URL: dashboard.tenderly.co/<account>/<project>/...
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=jetstreamgg
TENDERLY_PROJECT=jetstream
#
# (b) persistent fork: set an existing Virtual TestNet ADMIN RPC url. The fork is
#     stateful — every run continues from the previous run's mutations. The
#     simulator refuses URLs that do not look like Tenderly endpoints
#     (override: FORK_SIM_ALLOW_ANY_RPC=true).
#TENDERLY_RPC_URL=
#SIM_FRESH_FORK=true

# REQUIRED by parseBandConfig (same as the production bands bot). Per-market,
# per-cycle step caps in whole USDS. 1M is a sensible simulator default.
MAX_ALLOCATE_USDS=1000000
MAX_DEALLOCATE_USDS=1000000

# Market oracles. cbBTC/wstETH/WETH have no committed defaults; the values below
# were read from the Flagship vault's on-chain collateral-cap idData (2026-08-10)
# and cross-checked: computeMarketId with each oracle reproduces the live market id
# (PT-sUSDS = 0x9a8dab6d...f24f). The simulator's position-sum guard re-verifies
# them at startup — a wrong oracle aborts the run.
ORACLE_CBBTC=0xA5AEb90F9f122989fE69Ae6224Ed923A0caF33B4
ORACLE_WSTETH=0xc9A9440d1545047b2Ce3624DB425410cF2EAE292
ORACLE_WETH=0x76b2242ea5BE1FCBBF4206EA09601EA5aB22Af4d
# PT-sUSDS and stUSDS oracles default in market-config.ts; override only if they rotate.

# Simulator knobs (optional).
# Number of allocator cycles to run and fork-time hours between them. Longer gaps
# than the production 20-min cadence make Adaptive Curve anchor drift visible.
SIM_CYCLES=8
SIM_CYCLE_HOURS=6
# Simulated user inflow (whole USDS) deposited into the vault before cycle 1.
# Grows totalAssets, so the 20% sleeve cap rises and the reconciler's deposit
# budget opens — the way to watch the waterfilling feed PT-sUSDS when the sleeve
# starts above the cap. Unset/0 = no inflow.
#SIM_INFLOW_USDS=5000000

# Optional band-strategy overrides (defaults match docs/band-steering.md):
# SSR_T_MARGIN_BPS=25  SSR_T_TOLERANCE_BPS=25  UTIL_DEADBAND_BPS=50
# MIN_BAND_ACTION_USDS=100000  SLEEVE_FLOOR_BPS=1500  DIRECTION_COOLDOWN_HOURS=24
# MONOPOLIST_SHARE_BPS=8000  SSR_MIN_APY_BPS=100  SSR_MAX_APY_BPS=1500
# Per-market: SSR_T_MARGIN_PTSUSDS_BPS=... MODE_PTSUSDS=STEERED|RETIRED etc.

# Optional deployment overrides (defaults = mainnet Flagship from the README):
# VAULT_ADDRESS=0xE15fcC81118895b67b6647BBd393182dF44E11E0
# ADAPTER_ADDRESS=0xf94BE39e8863183Ff41194b5923627C90A34039D
# SAFE_ADDRESS=0xE4d5F54CE1830d5eCC49751021F306CFE7a52649
