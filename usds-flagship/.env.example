# ============ CORE (both modes) ============

# REQUIRED. Ethereum RPC endpoint — there is NO default; the bot throws if unset.
RPC_URL=
PRIVATE_KEY=0x...
# Safe 1/3 multisig address (must be set as allocator on the vault)
SAFE_ADDRESS=0x...
VAULT_ADDRESS=
ADAPTER_ADDRESS=

# REQUIRED. Allocation strategy, no default — the bot throws if unset or invalid:
#   bps   = legacy static per-market bps targets (decision-identical to today's behavior;
#           the fail-loud execution hardening — required RPC_URL, non-zero exit on
#           revert/timeout, pending-nonce guard — applies to both modes)
#   bands = Phase A utilization-band SSR-floor rate steering
ALLOCATION_MODE=bands

# Kill switch: 'true' -> the bot logs "paused" and exits 0 without reading or
# executing anything. Anything else (including unset) runs normally.
BOT_PAUSED=false

# Upper bound (ms) on waiting for the Safe transaction receipt. A confirmation slower
# than this fails the run (non-zero exit); the pending-nonce guard keeps the next cycle
# from stacking a second tx behind the in-flight one. Default 300000 (5 min).
RECEIPT_TIMEOUT_MS=300000

# Dry run mode: 'true' simulates without executing.
DRY_RUN=false

# ============ MARKETS (both modes) ============

ORACLE_STUSDS=0x0A976226d113B67Bd42D672Ac9f83f92B44b454C
ORACLE_CBBTC=0x...
ORACLE_WSTETH=0x...
# PT-sUSDS/USDS oracle (defaults to the known market oracle if unset)
ORACLE_PTSUSDS=0xda5901EF31ecAFa6561B2e56B4997FAdd3dB4646
ORACLE_WETH=0x...
LLTV_STUSDS=860000000000000000
LLTV_CBBTC=860000000000000000
LLTV_WSTETH=860000000000000000
# PT-sUSDS/USDS uses 91.5% LLTV (not 86%)
LLTV_PTSUSDS=915000000000000000
LLTV_WETH=860000000000000000

# PT-sUSDS/USDS absolute allocation cap in USDS (enforced off-chain by the bot; clamps the
# effective per-market cap in BOTH modes — bands mode may override it with
# CAP_PTSUSDS_USDS). Defaults to 5,000,000 USDS.
PT_SUSDS_ABSOLUTE_CAP_USDS=5000000

# ============ BPS MODE ONLY (ALLOCATION_MODE=bps) ============

# Per-market allocation targets in basis points (10000 = 100%). The sum across ALL FIVE
# markets (including any without an oracle) must equal the bot's targetAllocatedPercent
# (2000 = 20%) — the bot throws on startup otherwise. Current scheme retires stUSDS and WETH
# to 0% and targets ~6.66% each on cbBTC / wstETH / PT-sUSDS (667 / 667 / 666 = 2000).
# IMPORTANT: every market that is grown OR drained must have its ORACLE_* set above.
# A market with no oracle (0x0) is ignored entirely — it is never allocated to, and if
# it still holds funds it can never be drained, so the migration would silently stall.
TARGET_STUSDS_BPS=0
TARGET_CBBTC_BPS=667
TARGET_WSTETH_BPS=667
TARGET_PTSUSDS_BPS=666
TARGET_WETH_BPS=0

# Max utilization (bps) the bot pushes WETH/USDS to while draining it (default 9300 = 93%).
# The bot withdraws only up to this utilization and waits (skips) when already at/above it.
# bps mode only — bands mode holds each market to its band decision's utilization instead.
WETH_MAX_UTILIZATION_BPS=9300

# ============ BANDS MODE ONLY (ALLOCATION_MODE=bands) ============
# All values below show the defaults; set them explicitly in production anyway.
# Amounts are whole USDS (parsed to 18 decimals).

# Per-market roles. Valid values: STEERED | PRIMARY | RETIRED (anything else throws;
# SOUNDING is a recognized name but refuses to start).
#   STEERED  = satAPY band steering toward the SSR floor
#   PRIMARY  = no band: always asks to be filled up to its cap, and that deposit is
#              served before every other deposit (at most ONE market may be PRIMARY)
#   RETIRED  = the bot never touches the market (not even above its cap)
MODE_STUSDS=RETIRED
MODE_CBBTC=STEERED
MODE_WSTETH=STEERED
MODE_WETH=STEERED
MODE_PTSUSDS=PRIMARY

# OPTIONAL per-market caps for bands mode, as an amount (whole USDS) and/or a share of
# totalAssets (bps) — the same off-chain-cap semantics as PT_SUSDS_ABSOLUTE_CAP_USDS in
# bps mode (the bot never reads the on-chain absolute cap). A market's cap is the smaller
# of whichever are set (CAP_<MARKET>_USDS falls back to PT_SUSDS_ABSOLUTE_CAP_USDS for
# PT-sUSDS); a market with none is bounded only by the on-chain relative cap at allocate
# time and never emits a priority withdrawal, exactly as in bps mode. With a cap:
#   - a STEERED / PRIMARY market never targets above it;
#   - a position above it by >= MIN_PRIORITY_WITHDRAWAL_USDS triggers a PRIORITY
#     withdrawal back to the cap (no cooldown, served before the band wishes when the
#     floor binds);
#   - 0 means "hold nothing": the whole position drains, down to the 100 USDS dust floor.
# CAP_CBBTC_USDS=
# CAP_CBBTC_BPS=1000
# CAP_WSTETH_USDS=
# CAP_WSTETH_BPS=1000
# CAP_WETH_USDS=
# CAP_WETH_BPS=500
# CAP_PTSUSDS_USDS=5000000
# CAP_PTSUSDS_BPS=1000
# CAP_STUSDS_USDS=0
# CAP_STUSDS_BPS=0

# Minimum priority withdrawal in USDS (default 50000): a position above its cap by
# less waits; a zero-cap market drains from the 100 USDS dust floor instead.
MIN_PRIORITY_WITHDRAWAL_USDS=50000

# REQUIRED in bands mode: per-cycle step caps in USDS on any single market's grow /
# drain. Both must be >= MIN_BAND_ACTION_USDS — a smaller cap would clamp every wish
# under the drop threshold and the bot could never act. (MAX_DEALLOCATE_USDS doubles as
# the bps-mode optional per-cycle deallocation cap, where 0/unset means uncapped.)
MAX_ALLOCATE_USDS=
MAX_DEALLOCATE_USDS=

# SSR target margin: SSR_t = SSR + this many bps (default 0). Per-market overrides
# (unset = the global value): SSR_T_MARGIN_CBBTC_BPS, SSR_T_MARGIN_WSTETH_BPS,
# SSR_T_MARGIN_WETH_BPS, SSR_T_MARGIN_PTSUSDS_BPS, SSR_T_MARGIN_STUSDS_BPS.
SSR_T_MARGIN_BPS=0
# SSR_T_MARGIN_PTSUSDS_BPS=

# HOLD-zone half-width around SSR_t in bps (default 25): no action while satAPY sits
# inside [SSR_t - tolerance, SSR_t + tolerance] — with margin 0 that is [SSR - 25, SSR + 25]
# bps: a rate slightly under SSR is accepted for more competitive borrow rates.
SSR_T_TOLERANCE_BPS=25

# Hold when current utilization is within this many bps of the band (default 50).
UTIL_DEADBAND_BPS=50

# Minimum action in USDS for steering legs and priority deposits — smaller legs are
# dropped (default 10000 = $10k); priority withdrawals use MIN_PRIORITY_WITHDRAWAL_USDS.
MIN_BAND_ACTION_USDS=10000

# Hard sleeve floor: the allocated sleeve never ends a batch below this fraction of
# totalAssets (bps, default 1500 = 15%; must be < 2000).
SLEEVE_FLOOR_BPS=1500

# Direction-change cooldown (hours): no grow within 24h of a drain and vice versa.
DIRECTION_COOLDOWN_HOURS=24

# Monopolist threshold (bps of the market's total supply): below 80% vault share a drain
# cannot move utilization, so the bot goes neutral instead (grows still allowed).
MONOPOLIST_SHARE_BPS=8000

# SSR sanity bounds (APY bps): a read outside [100, 1500] aborts the run.
SSR_MIN_APY_BPS=100
SSR_MAX_APY_BPS=1500

# How many blocks back to scan Morpho Blue Supply/Withdraw events for the adapter to
# resolve cooldown timestamps (default 7500 ~ 25h at 12s/block).
COOLDOWN_LOOKBACK_BLOCKS=7500
