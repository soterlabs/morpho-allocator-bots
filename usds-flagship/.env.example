# ============ CORE (both modes) ============

# REQUIRED. Ethereum RPC endpoint — there is NO default; the bot throws if unset.
RPC_URL=
PRIVATE_KEY=0x...
# Safe 1/3 multisig address (must be set as allocator on the vault)
SAFE_ADDRESS=0x...
VAULT_ADDRESS=
ADAPTER_ADDRESS=

# REQUIRED. Allocation strategy, no default — the bot throws if unset or invalid:
#   bps   = legacy static per-market bps targets (decision-identical to today's behavior;
#           the fail-loud execution hardening — required RPC_URL, non-zero exit on
#           revert/timeout, pending-nonce guard — applies to both modes)
#   bands = Phase A utilization-band SSR-floor rate steering
ALLOCATION_MODE=bands

# Emergency stop: 'true' -> the bot logs "paused" and exits 0 without reading or
# executing anything. Anything else (including unset) runs normally.
BOT_PAUSED=false

# Upper bound (ms) on waiting for the Safe transaction receipt. A confirmation slower
# than this fails the run (non-zero exit); the pending-nonce guard keeps the next cycle
# from stacking a second tx behind the in-flight one. Default 300000 (5 min).
RECEIPT_TIMEOUT_MS=300000

# Dry run mode: 'true' simulates without executing.
DRY_RUN=false

# ============ MARKETS (both modes) ============

ORACLE_STUSDS=0x0A976226d113B67Bd42D672Ac9f83f92B44b454C
ORACLE_CBBTC=0x...
ORACLE_WSTETH=0x...
# PT-sUSDS/USDS oracle (defaults to the known market oracle if unset)
ORACLE_PTSUSDS=0xda5901EF31ecAFa6561B2e56B4997FAdd3dB4646
ORACLE_WETH=0x...
LLTV_STUSDS=860000000000000000
LLTV_CBBTC=860000000000000000
LLTV_WSTETH=860000000000000000
# PT-sUSDS/USDS uses 91.5% LLTV (not 86%)
LLTV_PTSUSDS=915000000000000000
LLTV_WETH=860000000000000000

# PT-sUSDS/USDS absolute allocation cap in USDS (enforced off-chain by the bot; clamps the
# effective per-market cap in BOTH modes). Defaults to 5,000,000 USDS.
PT_SUSDS_ABSOLUTE_CAP_USDS=5000000

# ============ BPS MODE ONLY (ALLOCATION_MODE=bps) ============

# Per-market allocation targets in basis points (10000 = 100%). The sum across ALL FIVE
# markets (including any without an oracle) must equal the bot's targetAllocatedPercent
# (2000 = 20%) — the bot throws on startup otherwise. Current scheme retires stUSDS and WETH
# to 0% and targets ~6.66% each on cbBTC / wstETH / PT-sUSDS (667 / 667 / 666 = 2000).
# IMPORTANT: every market that is grown OR drained must have its ORACLE_* set above.
# A market with no oracle (0x0) is ignored entirely — it is never allocated to, and if
# it still holds funds it can never be drained, so the migration would silently stall.
TARGET_STUSDS_BPS=0
TARGET_CBBTC_BPS=667
TARGET_WSTETH_BPS=667
TARGET_PTSUSDS_BPS=666
TARGET_WETH_BPS=0

# Max utilization (bps) the bot pushes WETH/USDS to while draining it (default 9300 = 93%).
# The bot withdraws only up to this utilization and waits (skips) when already at/above it.
# bps mode only — bands mode holds each market to its band decision's utilization instead.
WETH_MAX_UTILIZATION_BPS=9300

# ============ BANDS MODE ONLY (ALLOCATION_MODE=bands) ============
# All values below show the DECIDED defaults (2026-07-30); set them explicitly in
# production anyway. Amounts are whole USDS (parsed to 18 decimals).

# Per-market roles. Valid values: STEERED | SOUNDING | RETIRED (anything else throws).
#   STEERED  = utilization-band rate steering toward the SSR floor
#   SOUNDING = demand sounding: feed tranches while utilization sticks >= 95%, never drain
#   RETIRED  = drain to zero
# PT-sUSDS maturity (2026-11-26T00:00:00Z) is hardcoded: grows blocked from T-30d,
# drained like RETIRED from T-14d.
MODE_STUSDS=RETIRED
MODE_CBBTC=STEERED
MODE_WSTETH=STEERED
MODE_WETH=STEERED
MODE_PTSUSDS=SOUNDING

# REQUIRED (> 0) in bands mode: per-cycle step caps in USDS on any single market's grow /
# drain. (MAX_DEALLOCATE_USDS doubles as the bps-mode optional per-cycle deallocation cap,
# where 0/unset means uncapped.)
MAX_ALLOCATE_USDS=
MAX_DEALLOCATE_USDS=

# SSR target margin: SSR_t = SSR + this many bps (default 15).
SSR_T_MARGIN_BPS=15

# Rate thresholds proportional to SSR: LOW = 4/7 x SSR, HIGH = 8/7 x SSR (LOW < HIGH
# enforced at startup).
BAND_LOW_FRAC_NUM=4
BAND_LOW_FRAC_DEN=7
BAND_HIGH_FRAC_NUM=8
BAND_HIGH_FRAC_DEN=7

# Utilization bands the bot HOLDS a STEERED market to (bps). Monotonicity is enforced at
# startup: drain >= mid >= high >= harvest.
BAND_UTIL_HARVEST_BPS=9000
BAND_UTIL_HIGH_BPS=9200
BAND_UTIL_MID_BPS=9300
BAND_UTIL_DRAIN_BPS=9400

# Hold when current utilization is within this many bps of the band (default 50).
UTIL_DEADBAND_BPS=50

# Minimum steering action in USDS — smaller deltas become holds (default 30000 = $30k).
MIN_BAND_ACTION_USDS=30000

# Hard sleeve floor: the allocated sleeve never steers below this fraction of totalAssets
# (bps, default 1200 = 12%; must be < 2000). RETIRED/winddown sweeps are never restored.
SLEEVE_FLOOR_BPS=1200

# SOUNDING (PT-sUSDS) tranches in USDS: first feed tops the position up to 3M, follow-ups
# add 1.5M — only while utilization >= 9500 bps and the last feed is >= 24h old.
SOUNDING_FIRST_TRANCHE_USDS=3000000
SOUNDING_NEXT_TRANCHE_USDS=1500000
SOUNDING_STICK_UTIL_BPS=9500
SOUNDING_FEED_COOLDOWN_HOURS=24

# Direction-change cooldown (hours): no grow within 24h of a drain and vice versa.
DIRECTION_COOLDOWN_HOURS=24

# Monopolist threshold (bps of the market's total supply): below 80% vault share a drain
# cannot move utilization, so the bot goes neutral instead (grows still allowed).
MONOPOLIST_SHARE_BPS=8000

# SSR sanity bounds (APY bps): a read outside [100, 1500] aborts the run.
SSR_MIN_APY_BPS=100
SSR_MAX_APY_BPS=1500

# How many blocks back to scan Morpho Blue Supply/Withdraw events for the adapter to
# resolve cooldown timestamps (default 7500 ~ 25h at 12s/block).
COOLDOWN_LOOKBACK_BLOCKS=7500
