RPC_URL=https://eth.llamarpc.com
PRIVATE_KEY=0x...
# Safe multisig address (threshold 1; must be an allocator on the USDT Savings vault, and the
# bot signer above must be one of its owners)
SAFE_ADDRESS=0x...
# sky.money USDT Savings Vault V2
VAULT_ADDRESS=0x23f5E9c35820f4baB695Ac1F19c203cC3f8e1e11
# MorphoMarketV1AdapterV2 for the vault (read from the vault: liquidityAdapter() / adapters(0))
ADAPTER_ADDRESS=
# Max utilization (bps) the bot pushes the OLD market to while withdrawing (default 9300 = 93%).
# It withdraws only up to this utilization and waits (does nothing) when already at/above it.
MAX_UTILIZATION_BPS=9300
# Dust floor in USDT (6 decimals): rounds moving less than this are skipped. Default 100.
MIN_MIGRATE_USDT=100
# Optional oracle overrides (defaults are the known old/new sUSDS/USDT market oracles). The bot
# asserts the resulting market ids match the known ids at startup, so a wrong value fails fast.
# OLD_ORACLE=0x0C426d174FC88B7A25d59945Ab2F7274Bf7B4C79
# NEW_ORACLE=0x1C7DBd66dF93594bA08af8e72c75Ba2004d92F9C
DRY_RUN=false
